# Copier en .env (ignoré par git) et compléter localement. Ne jamais committer .env.

# Mode d'exécution : backtest ou paper. Aucun mode réel n'existe dans le code.
BOT_MODE=paper
INITIAL_CAPITAL_EUR=20

# Capital.com : clé API du compte (live), utilisée UNIQUEMENT en lecture
# (prix, marchés). L'adaptateur bloque tout endpoint d'ordre.
# Créer de préférence une clé dédiée, et la révoquer en cas de doute.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=

# Sources de données gratuites (voir DATA_SOURCES.md)
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
# SEC EDGAR exige un User-Agent "Nom contact@email" : à renseigner localement.
SEC_USER_AGENT=
